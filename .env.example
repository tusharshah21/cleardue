# Postgres. Local: `docker compose up -d` gives the URL below. Hosted: your Neon connection string.
DATABASE_URL="postgresql://cleardue:cleardue@localhost:5433/cleardue"

# PayPal REST app credentials (SANDBOX ONLY). developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Must stay on sandbox. The client refuses any other host.
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
# "sandbox" (default) or "mock": an in-process fake PayPal for local development. Refused in production
# unless ALLOW_MOCK_IN_PROD="true" (for checking a deploy before sandbox credentials are set; the banner always shows).
PAYPAL_MODE="sandbox"
ALLOW_MOCK_IN_PROD="false"
# Merchant country the mock pretends to be (it refuses partial payments for IN, BR and IL, like PayPal)
PAYPAL_MOCK_COUNTRY="IN"
# Webhook ID from the sandbox app's webhook settings (used for signature verification, M2).
PAYPAL_WEBHOOK_ID=""
# Dev only: process webhook events that fail signature verification (e.g. simulator events). Ignored in production.
ALLOW_UNVERIFIED_WEBHOOKS="false"

# AI provider. Model names are read from env, never hard-coded.
# AI_PROVIDER is the primary (openai, google or anthropic) and AI_MODEL its model. AI_FALLBACK_PROVIDER / AI_FALLBACK_MODEL
# optionally name a secondary that takes over, once per request, on a quota error, a 5xx or a missing key on the primary;
# recorded responses come after that. Each provider needs its own key. Free-tier Gemini content may be used by Google to
# improve its products.
AI_PROVIDER="openai"
AI_MODEL="gpt-5.4-mini"
OPENAI_API_KEY=""
AI_FALLBACK_PROVIDER="google"
AI_FALLBACK_MODEL="gemini-3.5-flash-lite"
GOOGLE_GENERATIVE_AI_API_KEY=""
ANTHROPIC_API_KEY=""

# Replay recorded AI responses for the seeded demo clients (M2).
DEMO_MODE="false"

# Single demo login. SESSION_PASSWORD must be at least 32 characters.
DEMO_EMAIL="demo@cleardue.app"
DEMO_PASSWORD="change-me"
# Hosted demo only: the sync cron resets the three demo stories daily at 03:00 UTC.
DEMO_DAILY_RESET="false"
# Show the demo login on the login page even when DEMO_MODE is off (the hosted demo). It is public in the README.
SHOW_DEMO_LOGIN="false"
# AG Studio licence key (the /analyst dashboard). Client-side by design; read on that page only. Without it Studio shows a trial watermark.
AG_STUDIO=""
SESSION_PASSWORD="replace-with-a-random-string-of-32-plus-chars"

# Public base URL, used to build /pay/[token] links.
# Optional override of the public base URL (custom domain). On Render it defaults to RENDER_EXTERNAL_URL.
APP_URL="http://localhost:3000"

# Shared secret for the /api/sync polling endpoint (called by a Render cron job).
CRON_SECRET=""

# Only for npm run paypal:spike: a sandbox personal account email, and any inbox to test AP forwarding.
SPIKE_PAYER_EMAIL=""
SPIKE_AP_EMAIL=""

# Seed: sandbox personal account that receives (and pays) the demo invoices, and an AP inbox for Acme.
SEED_CLIENT_EMAIL=""
SEED_AP_EMAIL=""
