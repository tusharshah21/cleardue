generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Money is always integer minor units (cents) in the invoice currency.
// PayPal status strings are stored verbatim (DRAFT, SENT, PAID, ...).

model Freelancer {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  businessName String
  country      String // ISO 3166-1 alpha-2; drives the payment-plan strategy
  currency     String
  timezone     String
  mandate      Json // default mandate, see src/agent/mandate.ts
  clients      Client[]
  aiCache      AiCache[]
  createdAt    DateTime  @default(now())
}

// First live result of an AI call, reused for identical inputs. Only the demo freelancer gets one (src/ai/cache.ts).
model AiCache {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  key          String // hash of provider, model, seed fingerprint, task and the call's inputs
  seed         String // fingerprint of the demo stories the entry was made under
  task         String
  model        String
  output       Json
  createdAt    DateTime   @default(now())

  @@unique([freelancerId, key])
}

model Client {
  id            String     @id @default(cuid())
  freelancerId  String
  freelancer    Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  name          String
  email         String
  approverEmail String?
  country       String
  currency      String
  timezone      String // IANA, used for quiet hours
  mandate       Json? // partial override of Freelancer.mandate (includes autopilot)
  projects      Project[]
  invoices      Invoice[]
  messages      Message[]
  createdAt     DateTime   @default(now())
}

model Project {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  scope     String // scope of record (proposal / SOW text)
  invoices  Invoice[]
  createdAt DateTime  @default(now())
}

model Invoice {
  id              String          @id @default(cuid())
  clientId        String
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id])
  paypalInvoiceId String?         @unique
  invoiceNumber   String?
  status          String          @default("DRAFT")
  currency        String
  totalMinor      Int
  paidMinor       Int             @default(0)
  issueDate       DateTime        @default(now())
  dueDate         DateTime
  items           Json // LineItem[], see src/paypal/invoices.ts
  note            String?
  payerViewUrl    String?
  payToken        String          @unique
  planGroupId     String?
  planGroup       PlanGroup?      @relation(fields: [planGroupId], references: [id])
  lastSyncedAt    DateTime?
  case            Case?
  messages        Message[]
  timeline        TimelineEvent[]
  payerQuestions  PayerQuestion[]
  tasks           Task[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
}

enum Direction {
  INBOUND
  OUTBOUND
}

model Message {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  direction Direction
  channel   String // paste | email | pay_page | outbox
  fromAddr  String?
  toAddr    String?
  subject   String?
  body      String
  status    String? // outbound only: queued | sent | failed
  sentAt    DateTime  @default(now())
}

model Case {
  id           String           @id @default(cuid())
  invoiceId    String           @unique
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reason       String? // forgot | awaiting_approval | cash_constraint | dispute | ...
  confidence   Float?
  summary      String?
  evidence     Json? // verbatim quotes backing the reason
  state        String           @default("open") // open | paused | dispute | resolved
  pausedUntil  DateTime?
  promisedDate DateTime?
  replayed     Boolean          @default(false) // latest diagnosis came from DEMO_MODE replay
  cached       Boolean          @default(false) // latest diagnosis reused a cached result from an earlier live run
  provider     String? // the provider and model that produced the latest live diagnosis, e.g. openai/gpt-5.4-mini
  actions      ProposedAction[]
  timeline     TimelineEvent[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProposedAction {
  id             String    @id @default(cuid())
  caseId         String
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type           String
  params         Json
  draft          String?
  confidence     Float?
  mandateVerdict String // allow | needs_approval | deny
  mandateReasons Json
  status         String    @default("pending") // pending | auto_executed | executed | rejected | superseded | denied | failed
  result         Json?
  createdAt      DateTime  @default(now())
  decidedAt      DateTime?
}

model TimelineEvent {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind      String
  summary   String
  data      Json?
  createdAt DateTime @default(now())
}

model PayerQuestion {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  citations Json
  escalated Boolean  @default(false)
  wantsPlan Boolean  @default(false) // the client asked to pay in parts
  replayed  Boolean  @default(false) // answer came from DEMO_MODE replay
  cached    Boolean  @default(false) // answer reused a cached result from an earlier live run
  provider  String? // the provider and model that produced a live answer
  createdAt DateTime @default(now())
}

// A payment plan the client accepted. split_invoices: the original is cancelled and replaced by one invoice
// per instalment. partial_payment: one replacement invoice that accepts part payments (not IN/BR/IL).
// State: drafted -> pending_send (original cancelled, a send failed; retried) -> active, or aborted.
model PlanGroup {
  id                String    @id @default(cuid())
  originalInvoiceId String    @unique
  strategy          String // split_invoices | partial_payment
  state             String    @default("drafted")
  instalments       Json // { amountMinor, dueDate }[]
  error             String?
  invoices          Invoice[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Something the freelancer has to handle by hand (payer-assistant escalations, complaints).
model Task {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      String // escalation | complaint
  summary   String
  detail    String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Every PayPal webhook delivery, for idempotency and audit. Simulator events can't pass signature
// verification, so they are stored with verified=false and only processed when ALLOW_UNVERIFIED_WEBHOOKS=true.
model WebhookEvent {
  id         String   @id // PayPal event id
  eventType  String
  resourceId String?
  verified   Boolean
  processed  Boolean  @default(false)
  note       String?
  payload    Json
  receivedAt DateTime @default(now())
}
// Small facts about the running system (last scheduled sync, last daily reset), so a missing cron is visible.
model AppState {
  key String   @id
  at  DateTime
}
